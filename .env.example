# Payment Guard environment variables
# Copy to .env.local and fill in only what you need.
# The demo runs with no configuration: the mock rail, rule engine and
# in-memory telemetry are the defaults.

# --- App URL ----------------------------------------------------------------
# Used for PayPal return/cancel URLs and absolute QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payment rail -----------------------------------------------------------
# mock (default) | paypal
PAYMENT_RAIL=mock

# --- PayPal Sandbox (only used when PAYMENT_RAIL=paypal) --------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PayPal does not settle KES. Use a supported currency when the PayPal rail is on.
PAYPAL_CURRENCY=USD
# From the PayPal developer dashboard. Required to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# --- AI advisory (optional) -------------------------------------------------
# Without a key the deterministic rule engine runs alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to off to force rules-only mode even when a key is present.
# PAYMENT_GUARD_AI=off

# --- Supabase (optional live telemetry + merchant registry) -----------------
# Without these the app uses the seeded in-memory registry and telemetry.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for writes under RLS (audit inserts + webhook updates).
# Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
