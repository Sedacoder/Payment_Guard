# Payment Guard environment variables
# Copy to .env.local and fill in only what you need.
# The demo runs with no configuration: the mock rail, rule engine and
# in-memory telemetry are the defaults.

# --- Payment rail -----------------------------------------------------------
# mock (default) | paypal
PAYMENT_RAIL=mock

# --- PayPal Sandbox (only used when PAYMENT_RAIL=paypal) --------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PayPal does not settle KES. Use a supported currency when the PayPal rail is on.
PAYPAL_CURRENCY=USD

# --- AI advisory (optional) -------------------------------------------------
# Without a key the deterministic rule engine runs alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Set to off to force rules-only mode even when a key is present.
# PAYMENT_GUARD_AI=off

# --- Supabase (reserved for the future telemetry adapter) -------------------
# Telemetry currently uses an in-memory sink with SSE. These are placeholders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
